# Copy to .env for local testing (Render uses the dashboard instead)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Paste the whole service-account JSON key on ONE line:
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Optional: tab name inside the sheet (default: Students)
# GOOGLE_SHEET_TAB=Students

# --- Quiz link and editor dashboard ---
# A long random secret shared with the Telegram quiz bot (set the SAME value there as QUIZ_API_KEY).
QUIZ_API_KEY=change-me-to-a-long-random-string
# Password for the editor dashboard at /admin
ADMIN_PASSWORD=change-me
# Link students tap to open the quiz, e.g. https://t.me/YourQuizBot
QUIZ_BOT_URL=https://t.me/your_quiz_bot
# Web address of the quiz service on Render (the same service as the Telegram bot), https only.
# With this set, students take the quiz inside their portal without leaving it.
QUIZ_APP_URL=https://your-quiz-service.onrender.com
# Optional: tab name for quiz results (default: Quiz Results)
# GOOGLE_QUIZ_TAB=Quiz Results

# --- One-time quiz codes ---
# The quiz is locked until a student enters a one-time code made on the dashboard's "Quiz codes" tab.
# Optional tab name for the codes (default: Quiz Codes)
# GOOGLE_QUIZCODE_TAB=Quiz Codes
# Optional, off by default: also require a code for the Telegram quiz. Turn on only after checking that the
# bot shows the website's error text when the website answers 403.
# QUIZ_CODE_FOR_TELEGRAM=on

# --- Alumni signals (Boom / Crash trade setups, shown on the alumni "Signals" page of the portal) ---
# Off unless this is on. The server then watches the markets over Deriv's WebSocket connection.
# SIGNALS=on
# Deriv app id. 1089 is Deriv's testing id; register your own at developers.deriv.com for production.
# DERIV_APP_ID=1089
# Minutes between reminders while a setup stays valid (default 2)
# SIGNAL_REMINDER_MINUTES=2
# Optional: also post every alert to a Telegram channel. Use a NEW bot token (revoke any old one in @BotFather).
# TELEGRAM_SIGNAL_TOKEN=
# TELEGRAM_SIGNAL_CHAT_ID=
